{
  "manifest_version": 3,
  "name": "YouTube Ad Blocker",
  "version": "0.1.0",
  "description": "Removes in-video YouTube ads in Safari.",
  "icons": {
    "16": "lib/icons/icon-16.png",
    "32": "lib/icons/icon-32.png",
    "48": "lib/icons/icon-48.png",
    "96": "lib/icons/icon-96.png",
    "128": "lib/icons/icon-128.png",
    "256": "lib/icons/icon-256.png",
    "512": "lib/icons/icon-512.png"
  },
  "permissions": ["scripting"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["lib/circuit-breaker.js", "content.js"],
      "run_at": "document_start"
    }
  ]
}
